{
  "manifest_version": 3,
  "name": "Gravity AI Flow Automation Client",
  "version": "1.0.0",
  "description": "Chrome automation integration for Gravity AI Studio Google Flow Generator.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow",
        "https://labs.google/fx/tools/flow/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "*://*.gravitylab.app/*",
      "*://localhost/*",
      "*://127.0.0.1/*"
    ]
  },
  "key": ""
}
